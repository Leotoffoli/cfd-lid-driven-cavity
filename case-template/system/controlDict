FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// __END__, __DT__ and __WI__ are replaced by scripts/run_all.sh (dt gives Courant number 0.5).
application     icoFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         __END__;
deltaT          __DT__;
writeControl    runTime;
writeInterval   __WI__;
purgeWrite      2;
writeFormat     ascii;
writePrecision  10;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;

functions
{
    // Centerline profiles at every write time; the last two writes are used as a steady-state check.
    centerlines
    {
        type            sets;
        libs            (sampling);
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          (U);
        sets
        {
            vertical
            {
                type    uniform;
                axis    y;
                start   (0.5 1e-6 0.05);
                end     (0.5 0.999999 0.05);
                nPoints 401;
            }
            horizontal
            {
                type    uniform;
                axis    x;
                start   (1e-6 0.5 0.05);
                end     (0.999999 0.5 0.05);
                nPoints 401;
            }
        }
    }
}
